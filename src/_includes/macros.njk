{% macro avatar(p, cls="") %}{% set a0 = (p.areas[0] | area) if p.areas.length else {color:"muted"} %}<span class="av {{ cls }}" data-c="{{ a0.color }}" aria-hidden="true">{{ p.initials }}{% if p.photo %}<img src="{{ p.photo }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">{% endif %}</span>{% endmacro %}

{% macro areaTags(ids) %}<span class="tags">{% for id in ids %}{% set a = id | area %}<a class="tag" data-c="{{ a.color }}" href="/research/{{ a.id }}/">{{ a.label or a.name }}</a>{% endfor %}</span>{% endmacro %}

{% macro personCard(p) %}{% set a0 = (p.areas[0] | area) if p.areas.length else {color:"muted"} %}
{% if p.pending %}
<div class="pcard pending" data-c="{{ a0.color }}" data-areas="{{ p.areas | join(' ') }}" data-search="{{ p.name | lower }}">
  {{ avatar(p) }}
  <div><div class="n">{{ p.name }}</div><div class="k">Profile coming soon</div>{% if p.areas.length %}<div class="tags">{% for id in p.areas %}{% set a = id | area %}<span class="tag" data-c="{{ a.color }}">{{ a.label or a.name }}</span>{% endfor %}</div>{% endif %}</div>
</div>
{% else %}
<a class="pcard" href="/people/{{ p.slug }}/" data-c="{{ a0.color }}" data-areas="{{ p.areas | join(' ') }}" data-search="{{ (p.name + ' ' + (p.keywords | join(' ')) + ' ' + (p.affiliation or '')) | lower }}">
  {{ avatar(p) }}
  <div><div class="n">{{ p.name }}</div><div class="k">{{ p.keywords | join(" · ") }}</div>
  <div class="tags">{% for id in p.areas %}{% set a = id | area %}<span class="tag" data-c="{{ a.color }}">{{ a.label or a.name }}</span>{% endfor %}</div></div>
</a>
{% endif %}
{% endmacro %}

{% macro pubItem(pub, showWho=true) %}
<li data-areas="{{ (pub.areas or []) | join(' ') }}">
  <a class="t" href="{{ pub.url }}" target="_blank" rel="noopener">{{ pub.title or pub.url }}</a>
  <span class="j">{{ pub.journal }}{% if pub.year and (pub.journal | string).indexOf(pub.year | string) == -1 %} ({{ pub.year }}){% endif %}</span>
  {% if showWho and pub.members %}<span class="who">{% for m in pub.members %}<a href="/people/{{ m.slug }}/">{{ m.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
</li>
{% endmacro %}

{% macro areaPanel(a, members) %}
<article class="area" data-c="{{ a.color }}">
  <div class="area-art">{% include "art/" + a.id + ".njk" ignore missing %}</div>
  <div class="area-body">
    <div class="kicker">{{ a.short }}</div>
    <h3><a href="/research/{{ a.id }}/">{{ a.name }}</a></h3>
    <p>{{ a.summary }}</p>
    {% if a.topics.length %}<ul class="topic-list">{% for t in a.topics %}<li>{{ t.name }}</li>{% endfor %}</ul>{% endif %}
    <div class="area-foot">
      <div class="faces">{% for p in members | senior %}{% if p.pending %}<span title="{{ p.name }}">{{ avatar(p) }}</span>{% else %}<a href="/people/{{ p.slug }}/" title="{{ p.name }}">{{ avatar(p) }}</a>{% endif %}{% endfor %}<span class="faces-count">{{ members | length }} people</span></div>
      <a class="more" href="/research/{{ a.id }}/">Explore</a>
    </div>
  </div>
</article>
{% endmacro %}

{% macro minorArea(a) %}
<div class="minor{% if a.art === false %} noart{% endif %}" data-c="{{ a.color }}">
  {% if a.art !== false %}<div class="mini-art">{% include "art/" + a.id + ".njk" ignore missing %}</div>{% endif %}
  <div><div class="kicker">{{ a.short }}</div><h3><a href="/research/{{ a.id }}/">{{ a.name }}</a></h3><p>{{ a.summary }}</p></div>
</div>
{% endmacro %}

{% macro pageBand(eyebrow, title, lede, artId="") %}
<section class="band page-band{% if not artId %} plain{% endif %}">
  <div class="wrap">
    <div class="head"><div class="eyebrow">{{ eyebrow | safe }}</div><h1>{{ title | safe }}</h1>{% if lede %}<p class="lede">{{ lede }}</p>{% endif %}</div>
    {% if artId %}{% include "art/" + artId + ".njk" ignore missing %}{% endif %}
  </div>
</section>
{% endmacro %}

{% macro seminarCard(s, open=false) %}{% set a = (s.area | area) if s.area else {color:"muted"} %}
<article class="seminar" data-c="{{ a.color }}">
  <time class="sdate" datetime="{{ s.date | isoDate }}"><b>{{ s.date | day }}</b><span>{{ s.date | month }} {{ s.date | year }}</span>{% if s.time %}<span>{{ s.time }}</span>{% endif %}</time>
  <div class="sbody">
    <h3>{{ s.title }}</h3>
    <div class="speaker">{{ s.speaker }}{% if s.affiliation %} <span class="muted">· {{ s.affiliation }}</span>{% endif %}</div>
    <div class="smeta">{% if s.room %}<span>{{ s.room }}</span>{% endif %}{% if s.online %}<a href="{{ s.online }}" target="_blank" rel="noopener">Join online</a>{% endif %}{% if s.slides %}<a href="{{ s.slides }}" target="_blank" rel="noopener">Slides</a>{% endif %}{% if s.video %}<a href="{{ s.video }}" target="_blank" rel="noopener">▶ Watch recording</a>{% endif %}{% if s.area %}<span class="tag" data-c="{{ a.color }}">{{ a.label or a.name }}</span>{% endif %}</div>
    {% if s.abstract %}<details{% if open %} open{% endif %}><summary>Abstract</summary><p>{{ s.abstract }}</p></details>{% endif %}
  </div>
</article>
{% endmacro %}

{% macro newsCard(n) %}{% set a = (n.data.area | area) if n.data.area else {color:"fcup"} %}
<a class="news-card{% if n.data.image %} has-img{% endif %}" href="{{ n.url }}" data-c="{{ a.color }}">
  {% if n.data.image %}<span class="news-img"><img src="{{ n.data.image }}" alt="" loading="lazy" onerror="this.parentNode.remove()"></span>{% endif %}
  <time datetime="{{ n.date | isoDate }}">{{ n.date | dateLong }}</time>
  <h3>{{ n.data.title }}</h3>
  {% if n.data.summary %}<p>{{ n.data.summary }}</p>{% endif %}
  <span class="more">Read</span>
</a>
{% endmacro %}

{% macro ytIcon() %}<svg class="yt-icon" viewBox="0 0 28 20" aria-hidden="true"><rect width="28" height="20" rx="5" fill="currentColor"/><path d="M11 5.5v9l8-4.5z" fill="var(--yt-play,#fff)"/></svg>{% endmacro %}

{% macro videoGrid(list, n=4) %}
<div class="video-grid">{% for v in list | batch(n) | first %}
  <a class="video" href="{{ v.url }}" target="_blank" rel="noopener">
    <span class="thumb"><img src="{{ v.thumb }}" alt="" loading="lazy">{{ ytIcon() }}</span>
    <span class="vt">{{ v.title }}</span>
    <time datetime="{{ v.date | isoDate }}">{{ v.date | dateLong }}</time>
  </a>{% endfor %}
</div>
{% endmacro %}

{% macro youtubeCta(site) %}
<a class="yt-cta" href="{{ site.youtube.url }}" target="_blank" rel="noopener">
  {{ ytIcon() }}
  <span><b>CFP on YouTube</b><span>{{ site.youtube.about }}</span></span>
  <span class="more">Open the channel</span>
</a>
{% endmacro %}

{% macro authorName(a) %}{% if a.member %}{% if a.slug %}<a class="cfp-author" href="/people/{{ a.slug }}/">{{ a.name }}</a>{% else %}<b class="cfp-author">{{ a.name }}</b>{% endif %}{% else %}{{ a.name }}{% endif %}{% endmacro %}

{% macro workItem(w) %}
<li data-areas="{{ w.areas | join(' ') }}" data-search="{{ (w.title + ' ' + w.journal + ' ' + (w.authors | map('name') | join(' '))) | lower }}">
  <a class="t" href="{{ w.url }}" target="_blank" rel="noopener">{{ w.title }}</a>
  {% if w.longList %}<details class="au"><summary>{% for a in w.authorsShort %}{% if a.gap %}… {% endif %}{{ authorName(a) }}{% if not loop.last %}, {% endif %}{% endfor %} <span class="more-au">… show all {{ w.authorsAll | length }} authors</span></summary>{% for a in w.authorsAll %}{{ authorName(a) }}{% if not loop.last %}, {% endif %}{% endfor %}</details>
  {% else %}<span class="au">{% for a in w.authorsAll %}{{ authorName(a) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
  <span class="j">{{ w.journal or ("Preprint" if w.type == "preprint" else "") }}{% if w.year %} ({{ w.year }}){% endif %}</span>
</li>
{% endmacro %}
