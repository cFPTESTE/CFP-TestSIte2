---
layout: base.njk
---
{% from "macros.njk" import avatar, pubItem, workItem, areaPanel, minorArea, seminarCard, newsCard, videoGrid, youtubeCta %}
<section class="band hero">
  <canvas id="moire" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="hero-copy">
      <div class="eyebrow">Centro de Física do Porto · since {{ site.founded }}</div>
      <h1>Theoretical physics, from quantum materials to the early Universe</h1>
      <p class="lede">{{ site.about }}</p>
      <div class="actions">
        <a class="btn primary" href="/research/">Explore our research</a>
        <a class="btn ghost" href="/people/">Meet the people</a>
      </div>
      <ul class="facts">
        <li><b data-count-up>{{ people | senior | length }}</b><span>Faculty &amp; researchers</span></li>
        <li><b data-count-up>{{ people | students | length }}</b><span>PhD &amp; MSc students</span></li>
        <li><b data-count-up>3</b><span>Core research areas</span></li>
        <li><b data-count-up>{{ site.fct_recognised }}</b><span>Recognised by FCT</span></li>
      </ul>
    </div>
  </div>
</section>

<div class="wrap">
  <section class="section" aria-labelledby="areas-h">
    <div class="section-head">
      <div><div class="eyebrow">Research</div><h2 id="areas-h" style="margin-top:8px">Research areas</h2></div>
      <a class="more" href="/research/">All research</a>
    </div>
    <div class="areas">
      {% for a in areas %}{% if a.core %}{{ areaPanel(a, people | inArea(a.id)) }}{% endif %}{% endfor %}
    </div>
    <div class="minor-areas">
      {% for a in areas %}{% if not a.core %}{{ minorArea(a) }}{% endif %}{% endfor %}
    </div>
  </section>

  <section class="section" aria-labelledby="news-h">
    <div class="section-head">
      <div><div class="eyebrow">News &amp; seminars</div><h2 id="news-h" style="margin-top:8px">News and seminars</h2></div>
      <a class="more" href="/news/">All news and seminars</a>
    </div>
    {% if seminars.upcoming.length %}<div class="seminar-list">{% for s in seminars.upcoming | batch(2) | first %}{{ seminarCard(s) }}{% endfor %}</div>{% endif %}
    <div class="news-grid">{% for n in collections.news | newest | batch(3) | first %}{{ newsCard(n) }}{% endfor %}</div>
  </section>

  {% if site.youtube %}
  <section class="section" aria-labelledby="watch-h">
    <div class="section-head">
      <div><div class="eyebrow">Watch</div><h2 id="watch-h" style="margin-top:8px">Seminars and journal clubs on YouTube</h2></div>
      <a class="more" href="{{ site.youtube.url }}" target="_blank" rel="noopener">Open the channel</a>
    </div>
    {% if videos.length %}{{ videoGrid(videos, 4) }}{% else %}{{ youtubeCta(site) }}{% endif %}
  </section>
  {% endif %}

  <section class="section" aria-labelledby="people-h">
    <div class="section-head">
      <div><div class="eyebrow">People</div><h2 id="people-h" style="margin-top:8px">{{ people | length }} physicists, from MSc students to full professors</h2></div>
      <a class="more" href="/people/">Everyone</a>
    </div>
    <div class="mosaic">
      {% for p in people %}{% if p.pending %}<span title="{{ p.name }}">{{ avatar(p) }}</span>{% else %}<a href="/people/{{ p.slug }}/" title="{{ p.name }}">{{ avatar(p) }}</a>{% endif %}{% endfor %}
    </div>
  </section>

  <section class="section" aria-labelledby="pubs-h">
    <div class="section-head">
      <div><div class="eyebrow">Publications</div><h2 id="pubs-h" style="margin-top:8px">Recent work</h2></div>
      <a class="more" href="/publications/">All publications</a>
    </div>
    <div class="pub-cols">
      {% if cfpWorks.length %}{% set recent = cfpWorks | batch(6) | first %}
      <ul class="pubs">{% for w in recent | batch(3) | first %}{{ workItem(w) }}{% endfor %}</ul>
      <ul class="pubs">{% for w in recent | batch(3) | last %}{{ workItem(w) }}{% endfor %}</ul>
      {% else %}{% set recent = publications | batch(6) | first %}
      <ul class="pubs">{% for pub in recent | batch(3) | first %}{{ pubItem(pub) }}{% endfor %}</ul>
      <ul class="pubs">{% for pub in recent | batch(3) | last %}{{ pubItem(pub) }}{% endfor %}</ul>
      {% endif %}
    </div>
  </section>
</div>

<script>
/* Moiré of two triangular lattices, slowly twisting (a nod to twisted bilayers). */
(()=>{
  const cv=document.getElementById("moire"); if(!cv) return;
  const ctx=cv.getContext("2d");
  const still=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const css=getComputedStyle(document.documentElement);
  const A=css.getPropertyValue("--art-a").trim()||"#C8D6E5", B=css.getPropertyValue("--art-b").trim()||"#92C1E9";
  let W=0,H=0,dpr=1,visible=true,t0=performance.now(),mx=0,my=0,tx=0,ty=0;
  cv.parentElement.addEventListener("pointermove",e=>{const r=cv.getBoundingClientRect();tx=(e.clientX-r.left)/r.width-.5;ty=(e.clientY-r.top)/r.height-.5;});
  cv.parentElement.addEventListener("pointerleave",()=>{tx=0;ty=0;});
  function size(){dpr=Math.min(window.devicePixelRatio||1,2);W=cv.clientWidth;H=cv.clientHeight;cv.width=W*dpr;cv.height=H*dpr;}
  function lattice(theta,color,cx,cy,a,r){
    ctx.fillStyle=color;
    const c=Math.cos(theta),s=Math.sin(theta),h=a*Math.sqrt(3)/2;
    const R=Math.hypot(W,H), n=Math.ceil(R/a);
    for(let j=-n;j<=n;j++){const y0=j*h, x0=(j&1)*a/2;
      for(let i=-n;i<=n;i++){const x=i*a+x0;
        const X=cx+x*c-y0*s, Y=cy+x*s+y0*c;
        if(X<-4||Y<-4||X>W+4||Y>H+4) continue;
        ctx.fillRect(X-r,Y-r,2*r,2*r);}}
  }
  function draw(now){
    const t=(now-t0)/1000;
    ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);
    mx+=(tx-mx)*0.05; my+=(ty-my)*0.05;
    const cx=W*(0.78+mx*0.08), cy=H*(0.5+my*0.12), a=W<700?11:13;
    const twist=(3.2+2.2*Math.sin(t*0.12)+mx*3)*Math.PI/180;
    ctx.globalAlpha=.65; lattice(t*0.01,A,cx,cy,a,1.4);
    ctx.globalAlpha=.7;  lattice(t*0.01+twist,B,cx,cy,a,1.4);
    ctx.globalAlpha=1;
    // fade toward the text side
    const g=ctx.createLinearGradient(0,0,W,0);
    const bg=(css.getPropertyValue("--hero-bg").trim()||css.getPropertyValue("--night").trim()||"#0B1422");
    g.addColorStop(0,bg);g.addColorStop(W<900?0.75:0.38,bg);g.addColorStop(1,"rgba(0,0,0,0)");
    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
    if(!still&&visible) requestAnimationFrame(draw);
  }
  size(); addEventListener("resize",()=>{size(); if(still||!visible) draw(performance.now());});
  new IntersectionObserver(es=>{const v=es[0].isIntersecting; if(v&&!visible){visible=true;requestAnimationFrame(draw);} visible=v;}).observe(cv);
  requestAnimationFrame(draw);
})();
</script>
