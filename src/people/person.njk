---
layout: base.njk
pagination:
  data: profiles
  size: 1
  alias: p
permalink: "/people/{{ p.slug }}/"
eleventyComputed:
  title: "{{ p.name }}"
---
{% from "macros.njk" import avatar, pubItem, workItem %}
{% set a0 = (p.areas[0] | area) if p.areas.length else {color:"muted"} %}
<section class="band profile-band{% if p.scene %} has-visual{% endif %}" data-c="{{ a0.color }}">
  {% if p.scene %}<canvas class="research-visual" data-scene="{{ p.scene }}" aria-hidden="true"></canvas>{% endif %}
  <div class="wrap">
    {{ avatar(p, "lg") }}
    <div>
      <div class="eyebrow"><a href="/people/">People</a> · {{ p.categoryLabel }}</div>
      <h1>{{ p.name }}</h1>
      {% if p.affiliation %}<div class="role">{{ p.affiliation }}</div>{% endif %}
      {% if p.areas.length %}<div class="tags">{% for id in p.areas %}{% set a = id | area %}<a class="tag" data-c="{{ a.color }}" href="/research/{{ a.id }}/">{{ a.label or a.name }}</a>{% endfor %}</div>{% endif %}
      {% if p.featuredWorks.length %}<div class="featured" data-featured>
        <div class="fw-label">Featured work</div>
        <div class="fw-items">{% for f in p.featuredWorks %}<a class="fw-item{% if loop.first %} on{% endif %}" href="{{ f.url }}" target="_blank" rel="noopener"><span class="fw-title">{{ f.title }}</span><span class="fw-venue">{{ f.venue }}{% if f.year and (f.venue | string).indexOf(f.year | string) == -1 %} ({{ f.year }}){% endif %}</span></a>{% endfor %}</div>
      </div>{% endif %}
    </div>
  </div>
</section>

<div class="wrap">
<div class="profile">
  <div>
    {% if p.keywords.length %}<p class="keywords">{{ p.keywords | join(" · ") }}</p>{% endif %}
    <div class="prose">{% for para in p.bio | paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
    {% if p.publications.length %}
    <div class="eyebrow" style="margin:48px 0 8px">Selected publications</div>
    <ul class="pubs">{% for pub in p.publications %}{{ pubItem(pub, false) }}{% endfor %}</ul>
    {% endif %}
    {% if p.cfpPublications.length %}
    <div class="eyebrow" style="margin:48px 0 8px">Publications with CFP affiliation · {{ p.cfpPublications | length }}</div>
    <ul class="pubs">{% for w in p.cfpPublications | batch(10) | first %}{{ workItem(w) }}{% endfor %}</ul>
    {% if p.cfpPublications.length > 10 %}
    <details class="more-pubs"><summary>Show all {{ p.cfpPublications | length }}</summary>
      <ul class="pubs">{% for w in p.cfpPublications %}{% if loop.index > 10 %}{{ workItem(w) }}{% endif %}{% endfor %}</ul>
    </details>
    {% endif %}
    {% endif %}
  </div>
  <aside class="sidebar" aria-label="Contact and links">
    <dl>
      {% if p.email %}<div><dt>Email</dt><dd><span class="mono">{{ p.email }}</span><button class="copy" type="button" data-copy="{{ p.email }}">Copy</button></dd></div>{% endif %}
      {% if p.office %}<div><dt>Office</dt><dd>{{ p.office }}</dd></div>{% endif %}
      {% if p.orcid %}<div><dt>ORCID</dt><dd><a class="mono" href="https://orcid.org/{{ p.orcid }}" target="_blank" rel="noopener">{{ p.orcid }}</a></dd></div>{% endif %}
      {% if p.links.length %}<div><dt>Elsewhere</dt><dd>{% for l in p.links %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</dd></div>{% endif %}
    </dl>
  </aside>
</div>
</div>
