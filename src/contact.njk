---
layout: base.njk
title: Contact
permalink: /contact/
---
<div class="page-head">
  <div class="eyebrow">Contact</div>
  <h1>Visit and contact</h1>
  <p class="lede">CFP is located in the Physics and Astronomy building (FC3) of the Faculty of Sciences, on the Campo Alegre campus.</p>
</div>
<div class="minor-areas" style="max-width:760px">
  <div class="minor">
    <h3>Address</h3>
    <p><address style="font-style:normal">{% for l in site.address %}{{ l }}<br>{% endfor %}</address></p>
    <p><a href="https://www.openstreetmap.org/search?query=Rua%20do%20Campo%20Alegre%20687%20Porto" target="_blank" rel="noopener">Open in map</a></p>
  </div>
  <div class="minor">
    <h3>Email</h3>
    {% if site.email %}<p><span class="mono">{{ site.email }}</span><button class="copy" type="button" data-copy="{{ site.email }}">Copy</button></p>
    {% else %}<p>To contact a member directly, use the email on their <a href="/people/">profile</a>.</p>{% endif %}
  </div>
</div>
